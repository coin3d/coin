if(CMAKE_SYSTEM_NAME STREQUAL "Linux" AND COIN_BUILD_SHARED_LIBS)
  find_package(Threads REQUIRED)
  add_executable(AuditorListTest auditors/List.cpp)
  target_link_libraries(AuditorListTest PRIVATE Coin Threads::Threads ${COIN_TARGET_LINK_LIBRARIES})
  target_include_directories(AuditorListTest PRIVATE
    ${PROJECT_SOURCE_DIR}/include ${PROJECT_BINARY_DIR}/include
    ${COIN_TARGET_INCLUDE_DIRECTORIES})
  add_test(NAME AuditorList_behavior COMMAND AuditorListTest)
  add_test(NAME AuditorList_empty COMMAND AuditorListTest empty)
  add_test(NAME AuditorList_endpoints COMMAND AuditorListTest endpoints)
  foreach(operation set remove object type)
    foreach(index -1 -2147483648 2147483647 4)
      add_test(NAME AuditorList_${operation}_${index} COMMAND AuditorListTest ${operation} ${index})
      set_tests_properties(AuditorList_${operation}_${index} PROPERTIES TIMEOUT 10)
    endforeach()
  endforeach()
  foreach(length 0 3 4 7 8 15 16 31 32)
    foreach(n RANGE 0 3)
      add_test(NAME AuditorList_alloc_${length}_${n} COMMAND AuditorListTest fail ${n} ${length})
      set_tests_properties(AuditorList_alloc_${length}_${n} PROPERTIES TIMEOUT 10)
    endforeach()
  endforeach()
endif()
