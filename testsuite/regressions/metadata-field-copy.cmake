foreach(variant Normal Allocation)
  if(variant STREQUAL "Allocation" AND NOT (CMAKE_SYSTEM_NAME STREQUAL "Linux" AND COIN_BUILD_SHARED_LIBS))
    continue()
  endif()
  set(target CoinMetadataFieldCopy${variant}Test)
  add_executable(${target} regressions/metadata/FieldCopy.cpp)
  target_link_libraries(${target} Coin ${COIN_TARGET_LINK_LIBRARIES})
  target_include_directories(${target} PRIVATE ${PROJECT_SOURCE_DIR}/include ${PROJECT_BINARY_DIR}/include ${COIN_TARGET_INCLUDE_DIRECTORIES})
  if(variant STREQUAL "Allocation")
    target_compile_definitions(${target} PRIVATE METADATA_ALLOCATION_TEST)
    foreach(operation RANGE 0 3)
      add_test(NAME MetadataFieldCopy_allocation_${operation} COMMAND ${target} ${operation})
    endforeach()
  else()
    add_test(NAME MetadataFieldCopy COMMAND ${target})
  endif()
endforeach()
