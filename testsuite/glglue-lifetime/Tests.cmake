if(COIN_BUILD_LEGACY_GL_RENDERER)
  set(_glglue_native_supported FALSE)
  set(_glglue_native_libraries)
  set(_glglue_native_includes)
  if(APPLE AND HAVE_CGL)
    set(_glglue_native_supported TRUE)
    set(_glglue_native_libraries ${OPENGL_LIBRARIES})
  elseif(CMAKE_SYSTEM_NAME STREQUAL "Linux")
    find_package(X11 QUIET)
    if(X11_FOUND AND HAVE_GLX)
      set(_glglue_native_supported TRUE)
      set(_glglue_native_libraries ${X11_LIBRARIES})
      set(_glglue_native_includes ${X11_INCLUDE_DIR})
    endif()
  endif()
  if(_glglue_native_supported)
    find_package(Threads REQUIRED)
    add_executable(GLGlueLifetimeTest glglue-lifetime/LifetimeTest.cpp)
    target_compile_definitions(GLGlueLifetimeTest PRIVATE COIN_INTERNAL HAVE_CONFIG_H)
    target_include_directories(GLGlueLifetimeTest PRIVATE
      ${PROJECT_SOURCE_DIR}/src ${PROJECT_SOURCE_DIR}/include
      ${PROJECT_BINARY_DIR}/src ${PROJECT_BINARY_DIR}/include
      ${COIN_TARGET_INCLUDE_DIRECTORIES} ${_glglue_native_includes})
    if(APPLE AND HAVE_CGL)
      target_compile_definitions(GLGlueLifetimeTest PRIVATE
        COIN_GLGLUE_TEST_CGL GL_SILENCE_DEPRECATION)
    endif()
    target_link_libraries(GLGlueLifetimeTest Coin Threads::Threads
      ${COIN_TARGET_LINK_LIBRARIES} ${_glglue_native_libraries})
    add_test(NAME GLGlueLifetime COMMAND GLGlueLifetimeTest)
    add_test(NAME GLGlueLifetimeNoCallbacks COMMAND GLGlueLifetimeTest --no-callbacks)
    set_tests_properties(GLGlueLifetime GLGlueLifetimeNoCallbacks PROPERTIES TIMEOUT 60)
    if(NOT APPLE)
      set_tests_properties(GLGlueLifetime GLGlueLifetimeNoCallbacks PROPERTIES SKIP_RETURN_CODE 77)
    endif()
  endif()
endif()
