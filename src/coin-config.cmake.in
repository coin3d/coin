cmake_minimum_required(VERSION 3.0...3.31)

# Have a look at VTKConfig.cmake.in, especially regarding UseVTK.cmake
# https://github.com/Kitware/VTK/blob/master/CMake/VTKConfig.cmake.in
# https://github.com/Kitware/VTK/blob/master/CMake/UseVTK.cmake
# Usage example:
# https://github.com/LuaDist/cmake/blob/master/Modules/FindVTK.cmake
# Bastiaan Veelo 2016.03.15

set(COIN_VERSION @COIN_MAJOR_VERSION@.@COIN_MINOR_VERSION@.@COIN_MICRO_VERSION@)
@PACKAGE_INIT@

# Check platform, architecture, and compiler compatibility (Issue #162)
if(NOT COIN_NO_COMPATIBILITY_CHECK)
	# 1. Operating system / Target system
	if(DEFINED CMAKE_SYSTEM_NAME AND NOT "@CMAKE_SYSTEM_NAME@" STREQUAL "")
		if(NOT CMAKE_SYSTEM_NAME STREQUAL "@CMAKE_SYSTEM_NAME@")
			message(WARNING "Coin was built for system '@CMAKE_SYSTEM_NAME@', but current project is targeting '${CMAKE_SYSTEM_NAME}'. This may cause compatibility issues.")
		endif()
	endif()

	# 2. Architecture bitness (pointer size)
	if(DEFINED CMAKE_SIZEOF_VOID_P AND NOT "@CMAKE_SIZEOF_VOID_P@" STREQUAL "")
		if(NOT CMAKE_SIZEOF_VOID_P EQUAL @CMAKE_SIZEOF_VOID_P@)
			math(EXPR _coin_bits "@CMAKE_SIZEOF_VOID_P@ * 8")
			math(EXPR _curr_bits "${CMAKE_SIZEOF_VOID_P} * 8")
			message(WARNING "Coin was built for ${_coin_bits}-bit architecture, but current project is targeting ${_curr_bits}-bit architecture. Combining them will cause link failures.")
		endif()
	endif()

	# 3. Compiler and C++ ABI compatibility
	set(_COIN_BUILT_WITH_MSVC "@MSVC@")
	set(_COIN_BUILT_COMPILER_ID "@CMAKE_CXX_COMPILER_ID@")
	set(_COIN_BUILT_MSVC_VERSION "@MSVC_VERSION@")
	set(_COIN_BUILT_MSVC_STATIC_RUNTIME "@COIN_BUILD_MSVC_STATIC_RUNTIME@")

	if(_COIN_BUILT_WITH_MSVC)
		if(DEFINED CMAKE_CXX_COMPILER_ID AND NOT MSVC)
			message(WARNING "Coin was built with MSVC (${_COIN_BUILT_COMPILER_ID}), but current project uses ${CMAKE_CXX_COMPILER_ID}. C++ ABI differences will likely cause link errors or runtime crashes.")
		elseif(MSVC AND DEFINED MSVC_VERSION AND NOT _COIN_BUILT_MSVC_VERSION STREQUAL "")
			# Check Visual Studio toolset compatibility
			if((_COIN_BUILT_MSVC_VERSION LESS 1900 AND NOT (MSVC_VERSION LESS 1900)) OR
			   (NOT (_COIN_BUILT_MSVC_VERSION LESS 1900) AND MSVC_VERSION LESS 1900))
				message(WARNING "Coin was built with MSVC version ${_COIN_BUILT_MSVC_VERSION}, but current project uses MSVC version ${MSVC_VERSION}. MSVC versions prior to Visual Studio 2015 (1900) are binary incompatible with newer toolsets.")
			elseif(_COIN_BUILT_MSVC_VERSION LESS 1900 AND MSVC_VERSION LESS 1900)
				if(NOT MSVC_VERSION EQUAL _COIN_BUILT_MSVC_VERSION)
					message(WARNING "Coin was built with MSVC version ${_COIN_BUILT_MSVC_VERSION}, but current project uses MSVC version ${MSVC_VERSION}. MSVC versions prior to Visual Studio 2015 (1900) do not guarantee binary compatibility with different versions.")
				endif()
			elseif(MSVC_VERSION LESS _COIN_BUILT_MSVC_VERSION)
				message(WARNING "Coin was built with MSVC version ${_COIN_BUILT_MSVC_VERSION}, but current project uses older MSVC version ${MSVC_VERSION}. Microsoft C++ binary compatibility requires the consumer to use an MSVC version equal to or newer than linked libraries.")
			endif()

			# Check C runtime library linkage (static /MT vs dynamic /MD) per effective configuration
			set(_coin_configs_to_check "")
			if(DEFINED CMAKE_CONFIGURATION_TYPES AND NOT "${CMAKE_CONFIGURATION_TYPES}" STREQUAL "")
				set(_coin_configs_to_check ${CMAKE_CONFIGURATION_TYPES})
			elseif(DEFINED CMAKE_BUILD_TYPE AND NOT "${CMAKE_BUILD_TYPE}" STREQUAL "")
				set(_coin_configs_to_check "${CMAKE_BUILD_TYPE}")
			else()
				set(_coin_configs_to_check "Release")
			endif()

			foreach(_coin_cfg IN LISTS _coin_configs_to_check)
				string(TOUPPER "${_coin_cfg}" _coin_cfg_upper)
				set(_cfg_is_static FALSE)

				if(DEFINED CMAKE_MSVC_RUNTIME_LIBRARY)
					set(_rt_val "${CMAKE_MSVC_RUNTIME_LIBRARY}")
					foreach(_c IN LISTS _coin_configs_to_check)
						if("${_c}" STREQUAL "${_coin_cfg}")
							string(REPLACE "$<CONFIG:${_c}>" "1" _rt_val "${_rt_val}")
						else()
							string(REPLACE "$<CONFIG:${_c}>" "0" _rt_val "${_rt_val}")
						endif()
					endforeach()
					set(_std_configs Debug Release RelWithDebInfo MinSizeRel)
					foreach(_c IN LISTS _std_configs)
						if(NOT "${_c}" STREQUAL "${_coin_cfg}")
							string(REPLACE "$<CONFIG:${_c}>" "0" _rt_val "${_rt_val}")
						else()
							string(REPLACE "$<CONFIG:${_c}>" "1" _rt_val "${_rt_val}")
						endif()
					endforeach()
					unset(_std_configs)

					string(REPLACE "$<NOT:1>" "0" _rt_val "${_rt_val}")
					string(REPLACE "$<NOT:0>" "1" _rt_val "${_rt_val}")

					while(_rt_val MATCHES "\\$<0:[^>]*>")
						string(REGEX REPLACE "\\$<0:[^>]*>" "" _rt_val "${_rt_val}")
					endwhile()

					while(_rt_val MATCHES "\\$<1:([^>]*)>")
						string(REGEX REPLACE "\\$<1:([^>]*)>" "\\1" _rt_val "${_rt_val}")
					endwhile()

					string(REGEX REPLACE "\\$<[^>]*>" "" _rt_val "${_rt_val}")

					if(_rt_val MATCHES "MultiThreaded" AND NOT _rt_val MATCHES "DLL")
						set(_cfg_is_static TRUE)
					endif()
					unset(_rt_val)
				else()
					set(_flags "${CMAKE_CXX_FLAGS} ${CMAKE_CXX_FLAGS_${_coin_cfg_upper}}")
					if(_flags MATCHES "/MT")
						string(REGEX MATCHALL "/M[TD][d]?" _all_m_matches "${_flags}")
						if(_all_m_matches)
							list(REVERSE _all_m_matches)
							list(GET _all_m_matches 0 _last_m)
							if(_last_m MATCHES "/MT")
								set(_cfg_is_static TRUE)
							endif()
							unset(_last_m)
							unset(_all_m_matches)
						else()
							set(_cfg_is_static TRUE)
						endif()
					endif()
					unset(_flags)
				endif()

				if(_COIN_BUILT_MSVC_STATIC_RUNTIME AND NOT _cfg_is_static)
					message(WARNING "Coin was built with MSVC static runtime (/MT), but current project is configured for dynamic runtime (/MD) in configuration '${_coin_cfg}'. Mixing static and dynamic MSVC runtimes will cause link errors (LNK2038).")
				elseif(NOT _COIN_BUILT_MSVC_STATIC_RUNTIME AND _cfg_is_static)
					message(WARNING "Coin was built with MSVC dynamic runtime (/MD), but current project is configured for static runtime (/MT) in configuration '${_coin_cfg}'. Mixing static and dynamic MSVC runtimes will cause link errors (LNK2038).")
				endif()
				unset(_cfg_is_static)
				unset(_coin_cfg_upper)
			endforeach()
			unset(_coin_configs_to_check)
		endif()
	else()
		# Coin was not built with MSVC
		if(MSVC)
			message(WARNING "Coin was built with ${_COIN_BUILT_COMPILER_ID} (non-MSVC), but current project is using MSVC. C++ ABI differences will likely cause link errors or runtime crashes.")
		elseif(DEFINED CMAKE_CXX_COMPILER_ID AND NOT _COIN_BUILT_COMPILER_ID STREQUAL "")
			if(NOT CMAKE_CXX_COMPILER_ID STREQUAL _COIN_BUILT_COMPILER_ID)
				# GNU and Clang on Unix/Linux generally share the standard C++ library (libstdc++), but others might differ
				if(NOT (CMAKE_CXX_COMPILER_ID MATCHES "Clang|GNU" AND _COIN_BUILT_COMPILER_ID MATCHES "Clang|GNU"))
					message(WARNING "Coin was built with compiler '${_COIN_BUILT_COMPILER_ID}', but current project is using '${CMAKE_CXX_COMPILER_ID}'. This may lead to C++ ABI compatibility problems.")
				endif()
			endif()
		endif()
	endif()

	unset(_COIN_BUILT_WITH_MSVC)
	unset(_COIN_BUILT_COMPILER_ID)
	unset(_COIN_BUILT_MSVC_VERSION)
	unset(_COIN_BUILT_MSVC_STATIC_RUNTIME)
endif()
set(COIN_BUILD_MAC_FRAMEWORK @COIN_BUILD_MAC_FRAMEWORK@)
if(NOT COIN_BUILD_MAC_FRAMEWORK)

set_and_check(COINDIR "@PACKAGE_COINDIR@")
set_and_check(Coin_INCLUDE_DIR "@PACKAGE_COIN_INCLUDE_DIR@")
set_and_check(Coin_LIB_DIR "@PACKAGE_COIN_LIB_DIR@")

# optional directory from documentation component
if (EXISTS "@PACKAGE_COIN_DOC_DIR@/")
  set(Coin_DOC_DIR     "@PACKAGE_COIN_DOC_DIR@")
endif()

set(COIN_NAME @CMAKE_PROJECT_NAME@)

set(COIN_BUILD_SHARED_LIBS @COIN_BUILD_SHARED_LIBS@)
if(WIN32)
	if (COIN_BUILD_SHARED_LIBS)
		SET(Coin_DEFINES -DCOIN_DLL)
	else()
		SET(Coin_DEFINES -DCOIN_NOT_DLL)
	endif()
endif()

set(Coin_CONFIGURATION_TYPES @CMAKE_CONFIGURATION_TYPES@)
set(Coin_BUILD_TYPE @CMAKE_BUILD_TYPE@)
foreach(configuration IN LISTS Coin_CONFIGURATION_TYPES)
	if(configuration STREQUAL "Debug")
		set(Coin_LIBRARY_DEBUG ${COIN_NAME}@CMAKE_DEBUG_POSTFIX@)
	else()
		set(Coin_LIBRARY_RELEASE ${COIN_NAME}@CMAKE_RELEASE_POSTFIX@)
	endif()
endforeach()

if(NOT Coin_CONFIGURATION_TYPES)
	if(Coin_BUILD_TYPE STREQUAL "Debug")
		set(Coin_LIBRARY_RELEASE ${COIN_NAME}@CMAKE_DEBUG_POSTFIX@)
	else()
		set(Coin_LIBRARY_RELEASE ${COIN_NAME}@CMAKE_RELEASE_POSTFIX@)
	endif()
endif()

if(Coin_LIBRARY_RELEASE AND NOT Coin_LIBRARY_DEBUG)
	set(Coin_LIBRARY_DEBUG   ${Coin_LIBRARY_RELEASE})
	set(Coin_LIBRARY         ${Coin_LIBRARY_RELEASE})
	set(Coin_LIBRARIES       ${Coin_LIBRARY_RELEASE})
endif()

if(Coin_LIBRARY_DEBUG AND NOT Coin_LIBRARY_RELEASE)
	set(Coin_LIBRARY_RELEASE ${Coin_LIBRARY_DEBUG})
	set(Coin_LIBRARY         ${Coin_LIBRARY_DEBUG})
	set(Coin_LIBRARIES       ${Coin_LIBRARY_DEBUG})
endif()

if(Coin_LIBRARY_DEBUG AND Coin_LIBRARY_RELEASE)
	if(CMAKE_CONFIGURATION_TYPES OR CMAKE_BUILD_TYPE)
		# If the generator supports configuration types then set
		# optimized and debug libraries, or if the CMAKE_BUILD_TYPE has a value
		SET(Coin_LIBRARY optimized ${Coin_LIBRARY_RELEASE} debug ${Coin_LIBRARY_DEBUG})
	else()
		# If there are no configuration types and CMAKE_BUILD_TYPE has no value
		# then just use the release libraries
		SET(Coin_LIBRARY ${Coin_LIBRARY_RELEASE})
	endif()
	set(Coin_LIBRARIES optimized ${Coin_LIBRARY_RELEASE} debug ${Coin_LIBRARY_DEBUG})
endif()

set(Coin_LIBRARY ${Coin_LIBRARY} CACHE FILEPATH "The Coin library")
mark_as_advanced(Coin_LIBRARY_RELEASE Coin_LIBRARY_DEBUG)

endif()
include(CMakeFindDependencyMacro)

if(NOT COIN_BUILD_SHARED_LIBS)
	set(_OPENGL_FOUND @OPENGL_FOUND@)
	if(_OPENGL_FOUND)
		find_dependency(OpenGL)
	endif()
	set(_Threads_FOUND @Threads_FOUND@)
	if(_Threads_FOUND)
		find_dependency(Threads)
	endif()
	set(_EXPAT_FOUND @EXPAT_FOUND@)
	if(_EXPAT_FOUND)
		find_dependency(EXPAT)
	endif()
	set(_superglu_FOUND @superglu_FOUND@)
	if(_superglu_FOUND)
		find_dependency(superglu)
	endif()
	set(_ZLIB_FOUND @ZLIB_FOUND@)
	if(_ZLIB_FOUND)
		find_dependency(ZLIB)
	endif()
	set(_BZip2_FOUND @BZip2_FOUND@)
	if(_BZip2_FOUND)
		find_dependency(BZip2)
	endif()
	set(_Freetype_FOUND @Freetype_FOUND@)
	if(_Freetype_FOUND)
		find_dependency(Freetype)
	endif()
endif()

set(_simage_FOUND @simage_FOUND@)
if(_simage_FOUND)
	find_dependency(simage)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/@COIN_CONFIG_PACKAGE_BASENAME@-export.cmake")

# export "coin-config --have-feature" equivalent info
set(Coin_HAVE_3DS_IMPORT_CAPABILITIES @FEAT_HAVE_3DS@)
set(Coin_HAVE_VRML97 @FEAT_HAVE_VRML97@)
set(Coin_HAVE_SOUND @FEAT_HAVE_SOUND@)
set(Coin_HAVE_SUPERGLU @FEAT_HAVE_SUPERGLU@)
set(Coin_HAVE_THREADS @FEAT_HAVE_THREADS@)
set(Coin_HAVE_SAFETHREAD @FEAT_HAVE_SAFETHREAD@)
